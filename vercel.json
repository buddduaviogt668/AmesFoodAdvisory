{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/haccp",
      "destination": "/blog/haccp/what-is-haccp-nsw",
      "permanent": false
    },
    {
      "source": "/faq/faq-13",
      "destination": "/food-safety-faq-nsw",
      "permanent": true
    },
    {
      "source": "/guides/guide-7",
      "destination": "/how-to-prepare-for-council-food-safety-inspection",
      "permanent": true
    },
    {
      "source": "/guides/guide-23",
      "destination": "/blog/haccp/haccp-record-keeping-what-to-keep",
      "permanent": true
    },
    {
      "source": "/guides/guide-3",
      "destination": "/haccp-simplified",
      "permanent": true
    },
    {
      "source": "/guides/guide-9",
      "destination": "/free-resources",
      "permanent": true
    },
    {
      "source": "/guides/guide-10",
      "destination": "/free-resources",
      "permanent": true
    },
    {
      "source": "/faq/faq-4",
      "destination": "/food-safety-faq-nsw",
      "permanent": true
    },
    {
      "source": "/faq/faq-10",
      "destination": "/food-safety-faq-nsw",
      "permanent": true
    }
  ]
}